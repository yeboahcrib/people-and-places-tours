## Cloudflare Pages deployment headers.
##
## These hosts are required by the live site but appear nowhere in the page
## markup, so they must not be trimmed as unused:
##   challenges.cloudflare.com  Turnstile. Loads a script and renders inside an
##                              iframe, so it needs script-src, frame-src and
##                              connect-src.
##   cdn.sanity.io              Serves photographs uploaded to the CMS.
##   images.unsplash.com        Stock placeholder imagery.
##   *.cloudflareinsights.com   Web Analytics, injected automatically by
##                              Cloudflare. The script loads from
##                              static.cloudflareinsights.com and reports to
##                              cloudflareinsights.com, so it needs both
##                              script-src and connect-src. Sets no cookies.
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; img-src 'self' https://images.unsplash.com https://cdn.sanity.io data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; script-src-attr 'none'; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com; media-src 'self'; form-action 'self' https://formsubmit.co; upgrade-insecure-requests;
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/health.json
  Cache-Control: no-store
